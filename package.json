{
  "name": "verity",
  "version": "0.1.0-beta.2",
  "private": true,
  "description": "Checks whether a trusted repository can build, test, launch, and pass its real checks on this computer",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:contracts && npm run test:rust",
    "test:contracts": "node --test tests/verity-product-contract.test.js tests/verification-workspace-model.test.js tests/evidence-field-geometry.test.js tests/receipt-verification-contract.test.js tests/windows-release-acceptance.test.js",
    "test:licenses": "node scripts/audit-licenses.mjs",
    "test:site": "node scripts/validate-site.mjs",
    "test:rust": "cargo test --workspace",
    "build": "npm run build:desktop-web && cargo build --workspace",
    "build:desktop-web": "npm --prefix desktop run build:web",
    "check": "cargo check --workspace && npm run test:contracts",
    "dev:desktop": "npm --prefix desktop run dev:desktop",
    "acceptance:windows:manifest": "node scripts/run-windows-release-acceptance.mjs --validate-manifest",
    "acceptance:windows:preflight": "node scripts/run-windows-release-acceptance.mjs --preflight-projects",
    "acceptance:windows": "node scripts/run-windows-release-acceptance.mjs",
    "validate:windows-release": "node scripts/validate-windows-release-evidence.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logi-cmd/verity.git"
  }
}
